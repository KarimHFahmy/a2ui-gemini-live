# Copy to .env for local development.  Nothing here belongs in the image or in
# git — on Cloud Run these come from --set-env-vars and Secret Manager.

# --- Vertex AI (production path) -------------------------------------------
# Authentication uses Application Default Credentials, so no key material is
# needed: `gcloud auth application-default login` locally, and the runtime
# service account on Cloud Run.
#
# The backend translates these into the variables ADK reads
# (GOOGLE_GENAI_USE_VERTEXAI and friends) at startup, so this file is the only
# place they need to be set.
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Gemini Developer API (local shortcut) ---------------------------------
# Set USE_VERTEX_AI=false and supply a key from https://aistudio.google.com/apikey
# to develop without a Google Cloud project.
# USE_VERTEX_AI=false
# GOOGLE_API_KEY=

# --- Model -----------------------------------------------------------------
# Live model ids differ between Vertex AI and AI Studio and move while the Live
# API is in preview. Check the current list before a demo:
#   https://cloud.google.com/vertex-ai/generative-ai/docs/live-api
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# --- Voice and locale ------------------------------------------------------
# The demo targets the German market end to end.
LIVE_LANGUAGE_CODE=de-DE
LIVE_VOICE_NAME=Aoede
LIVE_AFFECTIVE_DIALOG=true
LIVE_PROACTIVE_AUDIO=false

# --- Server ----------------------------------------------------------------
PORT=8080
STATIC_DIR=static
LOG_LEVEL=INFO
# Only needed when the Vite dev server runs on a different origin than the API.
# ALLOWED_ORIGINS=http://localhost:5173
